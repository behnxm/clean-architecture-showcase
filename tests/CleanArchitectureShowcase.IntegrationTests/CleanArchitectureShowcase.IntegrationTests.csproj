<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      CA1707: Test method naming with underscores.
      xUnit1051: Test cancellation token in xUnit v3.
      CA1861: Constant array passed to arguments.
    -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CleanArchitectureShowcase.Domain\CleanArchitectureShowcase.Domain.csproj" />
    <ProjectReference Include="..\..\src\CleanArchitectureShowcase.Application\CleanArchitectureShowcase.Application.csproj" />
    <ProjectReference Include="..\..\src\CleanArchitectureShowcase.Infrastructure\CleanArchitectureShowcase.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CleanArchitectureShowcase.WebAPI\CleanArchitectureShowcase.WebAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
</Project>
