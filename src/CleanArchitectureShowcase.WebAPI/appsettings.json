{
  "ConnectionStrings": {
    // Default SQLite connection string.
    // To switch to PostgreSQL:
    // 1. Install Npgsql.EntityFrameworkCore.PostgreSQL.
    // 2. Update connection string to "Host=localhost;Database=productcatalog;Username=...;Password=...".
    // 3. In Infrastructure/DependencyInjection.cs, replace options.UseSqlite with options.UseNpgsql.
    // 4. Remove SQLite decimal converter in ApplicationDbContext.cs.
    // 5. Regenerate EF Core migrations: dotnet ef migrations add SwitchToPostgreSql.
    "Database": "Data Source=productcatalog.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "LoggingBehavior": {
    "SlowRequestThresholdMilliseconds": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
